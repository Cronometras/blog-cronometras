---
// WebpImage.astro - Componente unificado de imágenes responsivas con AVIF + WebP fallback.
//
// Fase 1 PSI: añade soporte <picture> con AVIF (cuando hay variante) + WebP + JPG/PNG original,
// y srcset responsivo (320/640/960/1280) para imágenes pre-generadas en /images/webp/lcp/.
//
// Modos:
//   1. Hero/LCP (src = LCP path): genera <picture> con AVIF + WebP + srcset desde /lcp/<size>.<ext>
//      y usa loading="eager" + fetchpriority="high". Configurado por `critical=true` o por la
//      detección automática de `isMainBannerImage`.
//   2. Estándar: <picture> con WebP + JPG/PNG original, loading="lazy".
//
// Nota: para la LCP se necesita generar previamente las variantes con `scripts/gen-lcp-variants.mjs`
//       (es un one-shot, no se ejecuta en cada build).

const { src, alt, width, height, class: className, critical = false, sizes = '(max-width: 640px) 100vw, 50vw' } = Astro.props;

// Detectar si es la imagen principal del banner (LCP en home)
const isMainBannerImage = src === '/images/webp/adaptada-a-moviles-tablets-y-pc.webp';

// Detectar si es una imagen local servida por /public/
const isLocalImage = src.startsWith('/images/');

// Construir rutas. Si la imagen es la LCP y existen variantes en /lcp/, usarlas con srcset.
// Si no, fallback al comportamiento anterior (single WebP + original).
const LCP_BASE = '/images/webp/lcp/adaptada';  // base sin extensión
const hasLcpVariants = isMainBannerImage;     // generado con scripts/gen-lcp-variants.mjs

// WebP/JPG fallback (single src para modo no-LCP, o WebP completo para LCP)
let webpSrc = src;
if (isLocalImage && !src.endsWith('.webp')) {
  const basePath = src.substring(0, src.lastIndexOf('/') + 1);
  const fileName = src.substring(src.lastIndexOf('/') + 1);
  const fileNameWithoutExt = fileName.substring(0, fileName.lastIndexOf('.'));
  const slugifiedFileName = fileNameWithoutExt
    .toLowerCase()
    .replace(/[áàäâãå]/g, 'a')
    .replace(/[éèëê]/g, 'e')
    .replace(/[íìïî]/g, 'i')
    .replace(/[óòöôõ]/g, 'o')
    .replace(/[úùüû]/g, 'u')
    .replace(/[ñ]/g, 'n')
    .replace(/[ç]/g, 'c')
    .replace(/[^a-z0-9.]/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
  webpSrc = `${basePath}webp/${slugifiedFileName}.webp`;
}
---

<picture class={isMainBannerImage ? 'banner-image-container' : ''}>
  {hasLcpVariants ? (
    <>
      {/* AVIF moderno (mejor compresión, ~30% menos que WebP) */}
      <source
        type="image/avif"
        srcset={`${LCP_BASE}-320.avif 320w, ${LCP_BASE}-640.avif 640w, ${LCP_BASE}-960.avif 960w, ${LCP_BASE}-1280.avif 1280w`}
        sizes={sizes}
      />
      {/* WebP fallback (soporte ~96%) */}
      <source
        type="image/webp"
        srcset={`${LCP_BASE}-320.webp 320w, ${LCP_BASE}-640.webp 640w, ${LCP_BASE}-960.webp 960w, ${LCP_BASE}-1280.webp 1280w`}
        sizes={sizes}
      />
    </>
  ) : (
    <source srcset={webpSrc} type="image/webp" />
  )}
  <img
    src={hasLcpVariants ? `${LCP_BASE}-640.webp` : src}
    alt={alt}
    width={width}
    height={height}
    class={className}
    loading={critical || isMainBannerImage ? 'eager' : 'lazy'}
    fetchpriority={critical || isMainBannerImage ? 'high' : 'auto'}
    decoding="async"
  />
</picture>

<style>
  img {
    max-width: 100%;
    height: auto;
  }
  /* Cuando no se pasan width/height, reservamos un espacio 16:9 para evitar CLS */
  img:not([width]) {
    aspect-ratio: 16 / 9;
    width: 100%;
    background: rgba(0, 0, 0, 0.05);
  }
</style>
