---
import { getAppShowcaseData, getAppShowcaseSrcset } from '../lib/appShowcases';

// WebpImage.astro - Un componente para usar imágenes WebP con fallback
const {
  src, alt, width, height, class: className, critical = false,
  sizes = '(min-width: 1280px) 600px, (min-width: 768px) 50vw, calc(100vw - 40px)',
  showcaseLayout = 'full',
} = Astro.props;

// Verificar si es la imagen principal del banner
const isMainBannerImage = /^\/(es|en)?\/?$/.test(Astro.url.pathname)
  && src === "/images/webp/adaptada-a-moviles-tablets-y-pc.webp";

// Verificar si la ruta de la imagen comienza con /images/
const isLocalImage = src.startsWith('/images/');

// Crear la ruta de la imagen WebP
let webpSrc = src;
if (isLocalImage) {
  // Verificar si la imagen ya es WebP
  if (src.endsWith('.webp')) {
    webpSrc = src;
  } else {
    // Si no es WebP, convertir la ruta
    const basePath = src.substring(0, src.lastIndexOf('/') + 1);
    const fileName = src.substring(src.lastIndexOf('/') + 1);
    const fileNameWithoutExt = fileName.substring(0, fileName.lastIndexOf('.'));
    const slugifiedFileName = fileNameWithoutExt
      .toLowerCase()
      .replace(/[áàäâãå]/g, 'a')
      .replace(/[éèëê]/g, 'e')
      .replace(/[íìïî]/g, 'i')
      .replace(/[óòöôõ]/g, 'o')
      .replace(/[úùüû]/g, 'u')
      .replace(/[ñ]/g, 'n')
      .replace(/[ç]/g, 'c')
      .replace(/[^a-z0-9.]/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
    webpSrc = `${basePath}webp/${slugifiedFileName}.webp`;
  }
}

const isArticle = /\/blog(?:\/|$)/.test(Astro.url.pathname);
const showcase = isArticle ? undefined : getAppShowcaseData(src);
const displaySrc = showcase?.src || src;
const responsiveSources = showcase ? getAppShowcaseSrcset(src) : undefined;
const displayAlt = alt && alt !== 'section-image'
  ? alt
  : showcase ? (Astro.url.pathname.startsWith('/en') ? showcase.altEn : showcase.altEs) : alt || '';
---

<picture class={isMainBannerImage ? 'banner-image-container' : ''}>
  <source srcset={responsiveSources || webpSrc} sizes={showcase ? sizes : undefined} type="image/webp">
  <img
    src={displaySrc}
    alt={displayAlt}
    width={showcase ? 1536 : width}
    height={showcase ? 1024 : height}
    class:list={[className, { 'app-showcase': showcase && showcaseLayout === 'full', 'app-showcase-thumbnail': showcase && showcaseLayout === 'thumbnail' }]}
    srcset={responsiveSources}
    sizes={showcase ? sizes : undefined}
    loading={critical || isMainBannerImage ? "eager" : "lazy"}
    fetchpriority={critical || isMainBannerImage ? "high" : "auto"}
    decoding="async"
  />
</picture>

<style>
  img {
    max-width: 100%;
    height: auto;
  }
  img.app-showcase {
    display: block;
    width: 100%;
    max-width: 42rem;
    height: auto;
    margin-inline: auto;
    border-radius: 1.25rem;
    object-fit: contain;
  }
  img.app-showcase-thumbnail {
    width: 9rem;
    height: 6rem;
    object-fit: contain;
    border-radius: 0.5rem;
  }
  /* The old 1.5× hover zoom was meant for narrow screenshots. */
  img.app-showcase:hover {
    transform: none;
  }
  /* Cuando no se pasan width/height, reservamos un espacio 16:9 para evitar CLS */
  img:not([width]) {
    aspect-ratio: 16 / 9;
    width: 100%;
    background: rgba(0, 0, 0, 0.05);
  }
</style>
