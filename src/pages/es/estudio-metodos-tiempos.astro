---
import Base from "@/layouts/Base.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config/config.json";

const title = "Estudio de Tiempos desde 800 € · 5 días · PDF + Excel";
const description =
  "Estudio profesional de tiempos estándar desde vídeo: suplementos OIT y descomposición por elementos. Informe PDF + Excel + JSON en 5 días. Desde 800 €.";
const canonical = `${config.site.base_url}/es/estudio-metodos-tiempos`;

// JSON-LD: Service
const jsonLdService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Estudio de Métodos y Tiempos",
  "name": "Estudio de Métodos y Tiempos Online con Cronometras",
  "description": description,
  "url": canonical,
  "provider": {
    "@type": "Organization",
    "name": "Cronometras",
    "url": "https://cronometras.com",
  },
  "areaServed": { "@type": "Country", "name": "España" },
  "offers": {
    "@type": "Offer",
    "price": "800",
    "priceCurrency": "EUR",
    "priceSpecification": {
      "@type": "PriceSpecification",
      "price": "800",
      "priceCurrency": "EUR",
      "valueAddedTaxIncluded": false,
    },
    "availability": "https://schema.org/InStock",
  },
  "deliveryMethod": "Online",
};
