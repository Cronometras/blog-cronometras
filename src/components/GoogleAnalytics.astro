---
// GoogleAnalytics.astro — UNICA fuente de inicialización de gtag en el sitio.
// Antes había un snippet inline duplicado en Base.astro que machacaba el dataLayer
// y rompía el handshake con GA4 cuando la env var GTAG_ID no existía en CF Pages
// (gtag('config', undefined) → 0 sesiones). Ahora este componente es el único punto
// de inicialización, vive en el <head>, y siempre tiene fallback hardcoded.
//
// Patrón: Consent Mode v2 — por defecto analytics está 'denied' y
// CookieConsent.astro actualiza a 'granted' si el usuario acepta.
// gtag.js SOLO se carga si el usuario aceptó la categoría de análisis
// (consentimiento previo, AEPD; decisión Micaot 2026-10-27 — mismo patrón
// que prodcont: ni GA4 ni AdSense se cargan sin aceptación previa).
const GA_ID = import.meta.env.GTAG_ID
  || import.meta.env.GOOGLE_ANALYTICS_ID
  || 'G-7FCEX5D4FF';
---

<!-- Google tag (gtag.js) — consent mode v2 + cookieless pings -->
<script is:inline define:vars={{ GA_ID }}>
  window.GTAG_ID = GA_ID;
  window.dataLayer = window.dataLayer || [];
  window.gtag = function gtag(){ dataLayer.push(arguments); };

  // Estado por defecto: NO consentir analítica. CookieConsent.astro actualizará
  // analytics_storage a 'granted' sólo si el usuario acepta.
  gtag('consent', 'default', {
    'analytics_storage': 'denied',
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'wait_for_update': 500
  });
  gtag('js', new Date());
  gtag('config', GA_ID, {
    'send_page_view': true,
    'transport_type': 'beacon',
    'anonymize_ip': true
  });

  // Cargar gtag.js SOLO con consentimiento previo de análisis (consent-choice-v2
  // o su migración desde cookie-preferences). CookieConsent.astro también llama a
  // loadGtagScript() al aceptar; este handler cubre la carga en visitas posteriores.
  window.addEventListener('load', function() {
    try {
      var granted = false;
      try {
        var saved = JSON.parse(localStorage.getItem('consent-choice-v2') || 'null');
        if (saved && typeof saved.analytics === 'boolean' && saved.expires > Date.now()) granted = saved.analytics;
        else {
          var old = JSON.parse(localStorage.getItem('cookie-preferences') || 'null');
          if (old && typeof old.analytics === 'boolean') granted = old.analytics;
        }
      } catch (e) { /* Sin permiso almacenado no se carga nada. */ }
      if (granted) loadGtagScript();
    } catch (e) { /* si falla, seguimos sin tracking */ }
  });

  // Expuesto globalmente para que CookieConsent.astro lo llame al aceptar cookies.
  window.loadGtagScript = function() {
    if (document.getElementById('gtag-js')) return;
    var s = document.createElement('script');
    s.id = 'gtag-js';
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(s);

    setTimeout(function() {
      window.gtag('event', 'page_view', {
        page_title: document.title,
        page_location: window.location.href,
        page_path: window.location.pathname
      });
    }, 100);
  };
</script>
<script is:inline>
  // Capa de eventos: formularios, CTAs y chat (Micaot 2026-10-08)
  document.addEventListener('submit', function (e) {
    try {
      window.gtag && window.gtag('event', 'form_submit', {
        form_id: e.target.id || '(sin-id)',
        form_action: e.target.getAttribute('action') || '(sin-accion)',
        page_path: location.pathname
      });
    } catch (err) {}
  }, true);
  document.addEventListener('click', function (e) {
    try {
      var t = e.target.closest && e.target.closest('a,button');
      if (t) {
        var txt = (t.innerText || '').trim();
        if (txt.length < 80 && /demo|prueba|solicitar|presupuesto|contact|quote|asisten/i.test(txt)) {
          window.gtag && window.gtag('event', 'cta_click', { event_label: txt.slice(0, 60), page_path: location.pathname });
        }
      }
    } catch (err) {}
  }, true);
</script>

<!-- Cloudflare Web Analytics (beacon sin cookies) -->
<script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "13d38089d9df46ff9f33b59964acbae3"}'></script>