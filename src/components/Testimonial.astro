---
import { markdownify } from "@/lib/utils/textConverter";


export type TestimonialItem = {
  avatar?: string;
  author: string;
  organization: string;
  content: string;
  rating: number;
};

export type Testimonial = {
  title: string;
  description: string;
  testimonial_list: TestimonialItem[];
};

const { testimonial } = Astro.props;
---

<!--
  Testimonial OCULTO del bundle (Micaot Fase 2 — 2026-06-29).
  Antes: importaba TestimonialSlider React con Swiper + react-feather.
  Aunque estuviera comentado en index.astro, Astro incluye el módulo en el
  bundle porque el import es top-level. Eso arrastraba 760 KB de react-feather
  + Swiper (~50 KB) a TODA la home.

  Reactivar: descomentar TODO el bloque y cambiar el import.
-->

<template id="testimonial-data" data-title={testimonial.title} data-description={testimonial.description} class="hidden">
  {testimonial.testimonial_list.map((item, i) => (
    <div data-avatar={item.avatar} data-author={item.author} data-org={item.organization} data-rating={item.rating}>
      <Fragment set:html={markdownify(item.content)} />
    </div>
  ))}
</template>
