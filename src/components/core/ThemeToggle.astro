---
// ThemeToggle.astro — Migra IoSunny/IoMoon de react-icons a SVG inline.
// Razón: import { IoSunny, IoMoon } from "react-icons/io5" arrastraba toda
// la librería react-icons (~760 KB) al bundle del cliente por solo 2 iconos.
// Fase 2 PSI — 2026-06-29.
//
// SVGs de Ionicons v5 (io5), extraídos de https://ionic.io/ionicons, mismos paths
// que usaba react-icons/io5, dominio MIT.
const SUN_ICON = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M256 144a112 112 0 1 0 112 112 112 112 0 0 0-112-112zm0 192a80 80 0 1 1 80-80 80 80 0 0 1-80 80z"/><path d="M502 256h-48v-32h32v-32h-32v-32h-32v32h-32v32h32v32h-32v32h32v32h32v-32h32v-32h16v-32h-16zM240 96V64h32v32zm0 320v32h32v-32zM64 240H32v32h32zm384 224h-32v32h32zm-32-32h-32v32h32zm-256 32h-32v32h32zm-32-352h-32v32H96v-32H64v32H32v32h32v32h32v-32h32v-32zm0-128H96v32h32zm224 0h32v32h-32zm-128 64v-32h-32v32z"/></svg>`;
const MOON_ICON = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M160 0c-11.2 0-21 6.4-26.4 16.2-5.4 9.7-4.5 21.7 2.3 30.5l39.5 50.7-65.2 33.5c-10.7 5.5-17 17-15.6 28.9 1.4 11.9 9.8 21.4 21.3 23.8l72.3 14.7-9.3 73.7c-1.5 11.9 5.3 23.1 16.2 27.9 11 4.8 23.7 2 31.7-6.9L256 256l49.2 36c8 5.9 18.7 7.5 28.1 3.7l69.3-28.5c10.5-4.3 16.9-14.6 15.7-25.7l-7.9-74.6 73.5-14.4c11.5-2.3 19.9-11.8 20.7-23.5.8-11.7-6-22.2-16.5-27.6l-65-32 39.5-50.4c6.7-8.6 7.7-20.5 2.5-30.3C460.3 6.5 450.3 0 439 0H160z"/></svg>`;
---

<button id="themeToggle" class="flex justify-center items-center" aria-label="Cambiar entre tema claro y oscuro">
  <span class="icon hidden dark:block text-white text-xl md:text-base" set:html={SUN_ICON} />
  <span class="icon block dark:hidden text-gray-700 text-xl md:text-base" set:html={MOON_ICON} />
  <!-- {
    import.meta.env.MODE == "development" && (
      <span id="theme_label" class="ml-4 text-sm bg-rose-300 px-2 text-black">
      </span>
    )
  } -->
</button>

<script>
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  const setToggleListener = () => {
    let toggleBtn = document.getElementById("themeToggle");
    const handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle("dark");

      const isDark = element.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      //@ts-ignore
      document.getElementById("theme_label").textContent = isDark
        ? "Dark theme"
        : "Light theme";

      // Disparar un evento personalizado para notificar el cambio de tema
      document.dispatchEvent(new CustomEvent('themeChanged', { detail: { isDark } }));
    };

    toggleBtn?.addEventListener("click", handleToggleClick);
  };

  setToggleListener();

  document.addEventListener("astro:after-swap", setToggleListener);
  //@ts-ignore
  const label = document.getElementById("theme_label");

  if (label)
    label.textContent = theme === "dark" ? "Dark theme" : "Light theme";
</script>
